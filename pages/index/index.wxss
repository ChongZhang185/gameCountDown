/**index.wxss**/
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

.userinfo {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #aaa;
  width: 100%;
  height: 60vh;
}

.timer-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  position: relative;
}

.timer-result {
  font-size: 40rpx;
  color: #333;
  margin-bottom: 40rpx;
  font-weight: bold;
  position: absolute;
  top: -80rpx;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.timer-result.hidden {
  visibility: hidden;
  position: absolute;
  width: 0;
  height: 0;
  overflow: hidden;
}

.timer-btn {
  width: 400rpx !important;
  height: 400rpx !important;
  border-radius: 50% !important;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 36rpx;
  border: none;
}

.time-btn {
  margin-top: 60rpx;
  width: 240rpx !important;
  height: 72rpx !important;
  line-height: 72rpx;
  border-radius: 36rpx !important;
  background-color: #07c160;
  color: #fff;
  font-size: 28rpx;
  padding: 0;
  border: none;
}

.stopwatch-page {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  padding: 40rpx;
  box-sizing: border-box;
  overflow: hidden;
}

.stopwatch-result {
  flex-shrink: 0;
  font-size: 96rpx;
  font-weight: bold;
  color: #333;
  font-variant-numeric: tabular-nums;
  padding: 40rpx 0;
}

.stopwatch-records {
  flex: 1;
  min-height: 0;
  width: 100%;
  max-width: 600rpx;
  overflow-y: auto;
}

.stopwatch-record-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
  border-radius: 16rpx;
  background-color: #f7f7f7;
}

.stopwatch-record-index {
  width: 48rpx;
  font-size: 26rpx;
  color: #999;
}

.stopwatch-record-value {
  flex: 1;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  font-variant-numeric: tabular-nums;
}

.stopwatch-record-delete {
  flex-shrink: 0;
  width: 96rpx !important;
  height: 52rpx !important;
  line-height: 52rpx;
  border-radius: 26rpx !important;
  background-color: #ff6b6b;
  color: #fff;
  font-size: 24rpx;
  padding: 0;
  margin: 0;
  border: none;
}

.stopwatch-record-delete-hover {
  background-color: #e55a5a !important;
}

.stopwatch-record-btn {
  flex-shrink: 0;
  margin-bottom: 30rpx;
  width: 480rpx !important;
  height: 76rpx !important;
  line-height: 76rpx;
  border-radius: 38rpx !important;
  background-color: #07c160;
  color: #fff;
  font-size: 30rpx;
  padding: 0;
  border: none;
}

.stopwatch-record-btn-hover {
  background-color: #06ad56 !important;
}

.stopwatch-actions {
  flex-shrink: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 20rpx;
  width: 480rpx;
  box-sizing: border-box;
}

.stopwatch-btn {
  width: 200rpx !important;
  height: 88rpx !important;
  line-height: 88rpx;
  border-radius: 44rpx !important;
  background-color: #07c160;
  color: #fff;
  font-size: 32rpx;
  padding: 0;
  border: none;
}

.stopwatch-btn-pause {
  background-color: #ff6b6b;
}

.stopwatch-btn-reset {
  background-color: #f2f2f2;
  color: #333;
}

.tabbar {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-around;
  height: 100rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background-color: #fff;
  border-top: 1rpx solid #eee;
  box-sizing: content-box;
}

.tabbar-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 100%;
  color: #999;
}

.tabbar-item-active {
  color: #07c160;
}

.tabbar-icon {
  font-size: 40rpx;
  line-height: 1.2;
}

.tabbar-text {
  font-size: 24rpx;
  line-height: 1.4;
}