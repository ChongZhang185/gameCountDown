/**index.wxss**/
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

.userinfo {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #aaa;
  width: 100%;
  height: 60vh;
}

.timer-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  position: relative;
}

.timer-result {
  font-size: 40rpx;
  color: #333;
  margin-bottom: 40rpx;
  font-weight: bold;
  position: absolute;
  top: -80rpx;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.timer-result.hidden {
  visibility: hidden;
  position: absolute;
  width: 0;
  height: 0;
  overflow: hidden;
}

.timer-btn {
  width: 400rpx !important;
  height: 400rpx !important;
  border-radius: 50% !important;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 36rpx;
  border: none;
}

.time-btn {
  margin-top: 60rpx;
  width: 240rpx !important;
  height: 72rpx !important;
  line-height: 72rpx;
  border-radius: 36rpx !important;
  background-color: #07c160;
  color: #fff;
  font-size: 28rpx;
  padding: 0;
  border: none;
}